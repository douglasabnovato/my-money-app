PORT=3003
# MongoDB (Atlas gratuito: mongodb+srv://usuario:senha@cluster/mymoney)
MONGODB_URI=mongodb://127.0.0.1:27017/mymoney
# Segredo do JWT, mínimo 32 caracteres (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=
TOKEN_TTL=1d
CORS_ORIGINS=http://localhost:5173
